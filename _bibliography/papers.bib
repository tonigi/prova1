	url = {https://www.nature.com/articles/leu2017169},
	doi = {10.1038/leu.2017.169},
	abstract = {Polycythemia vera (PV) and essential thrombocythemia (ET) are myeloproliferative neoplasms with variable risk of evolution into post-PV and post-ET myelofibrosis, from now on referred to as secondary myelofibrosis (SMF). No specific tools have been defined for risk stratification in SMF. To develop a prognostic model for predicting survival, we studied 685 JAK2, CALR, and MPL annotated patients with SMF. Median survival of the whole cohort was 9.3 years (95\% CI: 8-not reached-NR-). Through penalized Cox regressions we identified negative predictors of survival and according to beta risk coefficients we assigned 2 points to hemoglobin level {\textless}11 g/dl, to circulating blasts 3\%, and to CALR-unmutated genotype, 1 point to platelet count {\textless}150 × 109/l and to constitutional symptoms, and 0.15 points to any year of age. Myelofibrosis Secondary to PV and ET-Prognostic Model (MYSEC-PM) allocated SMF patients into four risk categories with different survival (P{\textless}0.0001): low (median survival NR; 133 patients), intermediate-1 (9.3 years, 95\% CI: 8.1-NR; 245 patients), intermediate-2 (4.4 years, 95\% CI: 3.2–7.9; 126 patients), and high risk (2 years, 95\% CI: 1.7–3.9; 75 patients). Finally, we found that the MYSEC-PM represents the most appropriate tool for SMF decision-making to be used in clinical and trial settings.},
	language = {en},
	number = {12},
	urldate = {2018-03-23},
	journal = {Leukemia},
	author = {Passamonti, F. and Giorgino, T. and Mora, B. and Guglielmelli, P. and Rumi, E. and Maffioli, M. and Rambaldi, A. and Caramella, M. and Komrokji, R. and Gotlib, J. and Kiladjian, J. J. and Cervantes, F. and Devos, T. and Palandri, F. and De Stefano, V. and Ruggeri, M. and Silver, R. T. and Benevolo, G. and Albano, F. and Caramazza, D. and Merli, M. and Pietra, D. and Casalone, R. and Rotunno, G. and Barbui, T. and Cazzola, M. and Vannucchi, A. M.},
	month = dec,
	year = {2017},
	keywords = {MYSEC-PM},
	pages = {2726--2731},
	file = {Passamonti et al_2017_A clinical-molecular prognostic model to predict survival in patients with post.docx:/Users/toni/Sync/literature/zotero/Toni/Toni_1_Journals/Passamonti et al_2017_A clinical-molecular prognostic model to predict survival in patients with post.docx:application/vnd.openxmlformats-officedocument.wordprocessingml.document;Passamonti et al_2017_A clinical-molecular prognostic model to predict survival in patients with post.pdf:/Users/toni/Sync/literature/zotero/Toni/Toni_1_Journals/Passamonti et al_2017_A clinical-molecular prognostic model to predict survival in patients with post.pdf:application/pdf;Snapshot:/Users/toni/Zotero/storage/P9BQ54KQ/leu2017169a.html:text/html;Snapshot:/Users/toni/Zotero/storage/MBR28JBI/leu2017169.html:text/html},
