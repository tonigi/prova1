	journal = {European Biophysics Journal},
	author = {de Rosa, Matteo and Barbiroli, Alberto and Bonì, Francesco and Scalone, Emanuele and Mattioni, Davide and Vanoni, Maria A. and Patrone, Marco and Bollati, Michela and Mastrangelo, Eloise and Giorgino, Toni and Milani, Mario},
	month = jan,
