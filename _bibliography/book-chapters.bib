@incollection{azzini_application_2002,
	series = {Lecture {Notes} in {Computer} {Science}},
	title = {Application of {Spoken} {Dialogue} {Technology} in a {Medical} {Domain}},
	copyright = {©2002 Springer-Verlag Berlin Heidelberg},
	isbn = {978-3-540-44129-8 978-3-540-46154-8},
	url = {http://link.springer.com/chapter/10.1007/3-540-46154-X_64},
	doi = {10.1007/3-540-46154-X_64},
	abstract = {The paper describes the ITC-irst approach for handling spoken dialogue interactions over the telephone. In particular, we have used the technology to develop a telemedicine prototype system that provides health-care to chronic patients. First, the system architecture will be summarized, then we will describe an automatic service for home monitoring of patients affected by hypertension pathology. Patients must periodically introduce data into a database containing their personal medical records. The collected data are managed, according to well established medical guidelines, by a software agent connected to a relational database, which contains the detailed history of each patient.},
	language = {en},
	number = {2448},
	urldate = {2015-11-20},
	booktitle = {Text, {Speech} and {Dialogue}},
	publisher = {Springer Berlin Heidelberg},
	author = {Azzini, I. and Giorgino, T. and Falavigna, D. and Gretter, R.},
	editor = {Sojka, Petr and Kopeček, Ivan and Pala, Karel},
	month = sep,
	year = {2002},
	keywords = {Artificial Intelligence (incl. Robotics), Information Storage and Retrieval, Information Systems Applications (incl. Internet), Document Preparation and Text Processing},
	pages = {449--452},
	file = {Azzini et al_2002_Application of Spoken Dialogue Technology in a Medical Domain.pdf:/Users/toni/Sync/literature/zotero/Toni/Toni_2_BookChapters/Azzini et al_2002_Application of Spoken Dialogue Technology in a Medical Domain.pdf:application/pdf;Snapshot:/Users/toni/Zotero/storage/AB9XM3IN/3-540-46154-X_64.html:text/html},
}

@incollection{giorgino_analysis_2019,
	address = {New York, NY},
	series = {Methods in {Molecular} {Biology}},
	title = {Analysis {Libraries} for {Molecular} {Trajectories}: {A} {Cross}-{Language} {Synopsis}},
	isbn = {978-1-4939-9608-7},
	shorttitle = {Analysis {Libraries} for {Molecular} {Trajectories}},
	url = {https://doi.org/10.1007/978-1-4939-9608-7_20},
	doi = {10.1007/978-1-4939-9608-7_20},
	abstract = {Analyzing the results of molecular dynamics (MD)-based simulations usually entails extensive manipulations of file formats encoding both the topology (e.g., the chemical connectivity) and configurations (the trajectory) of the simulated system. This chapter reviews a number of software libraries developed to facilitate interactive and batch analysis of MD results with scripts written in high-level, interpreted languages. It provides a beginners’ introduction to MD analysis presenting a side-by-side comparison of major scripting languages used in MD and shows how to perform common analysis tasks within the Visual Molecular Dynamics (VMD), Bio3D, MDTraj, MDAnalysis, and High-Throughput Molecular Dynamics (HTMD) environments.},
	language = {en},
	urldate = {2020-06-29},
	booktitle = {Biomolecular {Simulations}: {Methods} and {Protocols}},
	publisher = {Springer},
	author = {Giorgino, Toni},
	editor = {Bonomi, Massimiliano and Camilloni, Carlo},
	year = {2019},
	keywords = {VMD, Molecular dynamics, Trajectory analysis, Bio3D, HTMD, MDAnalysis, MDTraj, Scripting languages},
	pages = {503--527},
}
